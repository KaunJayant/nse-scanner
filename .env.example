# NSE Volatility Scanner Configuration
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Zerodha Kite Connect (optional — for live trading)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Grok (xAI) — PRIMARY. Get key from https://console.x.ai
GROK_API_KEY=your_groq_api_key_here
GROK_MODEL=llama-3.3-70b-versatile

# Google Gemini — FALLBACK. Get key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Dashboard
DASHBOARD_PORT=8000
